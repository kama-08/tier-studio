{
  "name": "tier-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kama-08/tier-studio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --bun run vite --host 127.0.0.1",
    "build": "bun --bun run vite build",
    "preview": "bun --bun run vite preview --host 127.0.0.1",
    "typecheck": "bun --bun run tsc --noEmit",
    "lint": "bun --bun run oxlint --deny-warnings",
    "lint:fix": "bun --bun run oxlint --fix",
    "fmt": "bun --bun run oxfmt",
    "fmt:check": "bun --bun run oxfmt --check",
    "test": "bun --bun run vitest run",
    "test:watch": "bun --bun run vitest",
    "test:e2e": "bun --bun run playwright test",
    "test:desktop": "bun run tauri build --debug --no-bundle && bun tests/desktop/lifecycle.ts",
    "test:install": "bun ./node_modules/playwright/cli.js install chromium",
    "tauri": "bun ./node_modules/@tauri-apps/cli/tauri.js",
    "desktop:dev": "bun run tauri dev",
    "desktop:build": "bun run tauri build",
    "desktop:build:windows": "bun run tauri build --target x86_64-pc-windows-msvc --bundles nsis -- --locked",
    "release:validate": "bun scripts/release.ts validate",
    "release:prepare": "bun scripts/release.ts prepare",
    "cloudflare:login": "bun --bun run wrangler login --browser=false",
    "deploy:web": "bun run build && bun scripts/deploy-web.ts",
    "deploy:web:check": "bun run build && bun --bun run wrangler deploy --dry-run"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@tauri-apps/cli": "^2.12.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.0"
  },
  "packageManager": "bun@1.3.14"
}
