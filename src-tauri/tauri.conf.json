{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tier Studio",
  "version": "0.1.0",
  "identifier": "app.tierstudio.desktop",
  "build": {
    "beforeDevCommand": "bun run dev --mode desktop",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "bun run build --mode desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Tier Studio",
        "width": 1380,
        "height": 900,
        "minWidth": 480,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
